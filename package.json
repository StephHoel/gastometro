{
  "name": "gastometro",
  "main": "expo-router/entry",
  "version": "1.7.3",
  "homepage": "https://stephhoel.github.io/gastometro/",
  "scripts": {
    "verify:version-bump": "sh ./scripts/verify-version-bump.sh",
    "new-version": "sh ./scripts/add-new-version.sh",
    "release:upload": "sh ./scripts/release-upload.sh",
    "build:local": "sh ./scripts/build-local.sh",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:coverage:csv": "sh ./scripts/test-coverage-csv.sh",
    "clear:coverage": "rm -rf coverage",
    "clear:branches": "sh ./scripts/clear-branches.sh",
    "clear:modules": "sh ./scripts/clear-node_modules.sh",
    "clear": "sh ./scripts/clear.sh",
    "prebuild": "expo prebuild",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "start": "expo start --dev-client",
    "build:android": "eas build -p android --profile production",
    "build:local:eas": "eas build --platform android --local",
    "web": "expo start --web --dev-client --clear",
    "web:test:offline": "node scripts/start-web-test-offline.js",
    "sw:version": "node scripts/generate-sw-version.js",
    "web:build": "npm run sw:version && expo export --platform web --clear",
    "web:serve": "npx http-server dist -p 3000 -c-1",
    "check:ts": "npx tsc --noEmit",
    "check:biome": "npx biome check .",
    "check:expo": "npx expo-doctor",
    "deps:audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "3.1.1",
    "expo": "^58.0.22",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-linking": "~58.0.15",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.29",
    "expo-splash-screen": "~58.0.12",
    "nativewind": "^4.2.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.4.0",
    "react-native-safe-area-context": "~5.11.0",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-uuid": "^2.0.4",
    "react-native-web": "~0.21.4",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.23",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.13",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-native-svg-transformer": "^1.5.3",
    "react-test-renderer": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "react-native-reanimated",
          "react-native-worklets",
          "react-native-css-interop"
        ]
      }
    }
  },
  "private": true,
  "allowScripts": {
    "msgpackr-extract@3.0.4": true
  }
}
