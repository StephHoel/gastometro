{
  "name": "gastometro",
  "main": "expo-router/entry",
  "version": "1.12.0",
  "homepage": "https://stephhoel.github.io/gastometro/",
  "scripts": {
    "verify:version-bump": "sh ./scripts/verify-version-bump.sh",
    "new-version": "sh ./scripts/add-new-version.sh",
    "release:upload": "sh ./scripts/release-upload.sh",
    "build:local": "sh ./scripts/build-local.sh",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:coverage:csv": "sh ./scripts/test-coverage-csv.sh",
    "clear:coverage": "rm -rf coverage",
    "clear:branches": "sh ./scripts/clear-branches.sh",
    "clear:modules": "sh ./scripts/clear-node_modules.sh",
    "clear": "sh ./scripts/clear.sh",
    "prebuild": "expo prebuild",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "start": "expo start --dev-client",
    "build:android": "eas build -p android --profile production",
    "build:local:eas": "eas build --platform android --local",
    "web": "expo start --web --dev-client --clear",
    "web:test:offline": "node scripts/start-web-test-offline.js",
    "sw:version": "node scripts/generate-sw-version.js",
    "web:build": "npm run sw:version && expo export --platform web --clear",
    "web:serve": "npx http-server dist -p 3000 -c-1",
    "checks": "npm run check:ts && npm run check:biome && npm run check:expo && npm run check:deps",
    "check:ts": "npx tsc --noEmit",
    "check:biome": "npx biome check .",
    "check:expo": "npx expo-doctor",
    "deps:audit": "npm audit --omit=dev",
    "check:deps": "npx expo install --check",
    "test:e2e:web": "npx --yes --package=playwright@1.56.1 --package=tsx -- tsx scripts/test-web-routing-e2e.ts",
    "check:a11y:contrast": "node scripts/check-accessibility-contrast.cjs",
    "delete": "git branch --list \"feat/spec*\" | xargs -r git branch -D",
    "exclusive-committs": "git log --reverse --oneline origin/main..origin/[nome da branch]",
    "push-in-other-branch": "git push origin [branch auxiliar]:[branch de trabalho] --force-with-lease"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.1.0",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.10",
    "expo-router": "~58.0.33",
    "expo-sharing": "~58.0.24",
    "expo-splash-screen": "~58.0.15",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-uuid": "^2.0.4",
    "react-native-web": "~0.21.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.16",
    "prettier": "~3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-native-css-interop": "0.2.7",
    "react-native-reanimated": "~4.7.1",
    "react-native-svg-transformer": "^1.5.3",
    "react-native-worklets": "0.13.0",
    "tailwindcss": "^3.4.19",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=24 <=26",
    "npm": ">=11 <=12"
  },
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "react-native-reanimated",
          "react-native-worklets",
          "react-native-css-interop"
        ]
      }
    }
  },
  "private": true,
  "allowScripts": {
    "msgpackr-extract@3.0.4": true,
    "@parcel/watcher@2.6.0": true
  }
}
